{
  "schema_version": 10,
  "tool_version": "3.15.0",
  "install_current": "pnpm add -D fallow@3.15.0",
  "notes": "Pinned to Fallow 3.15.0. Combined envelopes use schema_version 10; dupes envelopes use schema_version 8.",
  "fixture_repo": "tests/fixtures/repos/fallow-contract",
  "envelope_fixtures": {
    "current": "tests/fixtures/fallow-envelopes/v3.15.0"
  },
  "commands": [
    {
      "id": "combined",
      "argv": ["--format", "json", "--quiet"],
      "kind": "combined",
      "schema_version": 10,
      "require_schema": true,
      "required_fields": [
        "kind",
        "schema_version",
        "version",
        "check.unused_files[]",
        "check.unused_exports[]",
        "check.unused_dependencies[]",
        "check.unresolved_imports[]",
        "check.circular_dependencies[]",
        "check.entry_points.total",
        "dupes.clone_groups[]",
        "health.findings[]",
        "health.file_scores[]"
      ],
      "optional_fields": ["check.boundary_violations[]"],
      "empty_ok": true,
      "instance_fields": ["file", "start_line", "end_line"],
      "file_score_fields": [
        "path",
        "total_cyclomatic",
        "total_cognitive",
        "crap_above_threshold"
      ]
    },
    {
      "id": "list-boundaries",
      "argv": ["list", "--boundaries", "--format", "json", "--quiet"],
      "kind": "list-boundaries",
      "require_schema": false,
      "required_fields": [
        "kind",
        "boundaries.configured",
        "boundaries.zones[]",
        "boundaries.rules[]"
      ],
      "zone_fields": ["name", "patterns", "file_count"]
    },
    {
      "id": "dupes-semantic",
      "argv": ["dupes", "--mode", "semantic", "--format", "json", "--quiet"],
      "kind": "dupes",
      "schema_version": 8,
      "require_schema": true,
      "required_fields": ["kind", "schema_version", "clone_groups[]"],
      "instance_fields": ["file", "start_line", "end_line"],
      "empty_ok": true
    },
    {
      "id": "dead-code-trace",
      "argv": [
        "dead-code",
        "--trace",
        "<file:export>",
        "--format",
        "json",
        "--quiet"
      ],
      "kind": "trace",
      "require_schema": false,
      "required_fields": ["kind", "file", "export_name", "is_used", "reason"]
    },
    {
      "id": "dead-code-trace-file",
      "argv": [
        "dead-code",
        "--trace-file",
        "<file>",
        "--format",
        "json",
        "--quiet"
      ],
      "kind": "trace",
      "require_schema": false,
      "required_fields": ["kind", "file"]
    },
    {
      "id": "dead-code-trace-dependency",
      "argv": [
        "dead-code",
        "--trace-dependency",
        "<name>",
        "--format",
        "json",
        "--quiet"
      ],
      "kind": "trace",
      "require_schema": false,
      "required_fields": ["kind", "package_name", "is_used"]
    }
  ]
}
