{
  "schema_version": 7,
  "tool_version_min": "3.10.0",
  "tool_version_current": "3.14.0",
  "status": "tested",
  "install_current": "npm install --save-dev fallow@3.14.0",
  "notes": "Range selected from evidence: schema_version 7 holds through 3.14.0; 3.10.0 is the first release that stamps kind on trace envelopes; 3.15.0 emits schema 10 and is out of range until a follow-up expands the contract.",
  "fixture_repo": "tests/fixtures/repos/fallow-contract",
  "envelope_fixtures": {
    "min": "tests/fixtures/fallow-envelopes/v3.10.0",
    "current": "tests/fixtures/fallow-envelopes/v3.14.0",
    "below_min": "tests/fixtures/fallow-envelopes/v3.9.1"
  },
  "commands": [
    {
      "id": "combined",
      "argv": ["--format", "json", "--quiet"],
      "kind": "combined",
      "require_schema": true,
      "required_fields": [
        "kind",
        "schema_version",
        "version",
        "check.unused_files[]",
        "check.unused_exports[]",
        "check.unused_dependencies[]",
        "check.unresolved_imports[]",
        "check.circular_dependencies[]",
        "check.entry_points.total",
        "dupes.clone_groups[]",
        "health.findings[]",
        "health.file_scores[]"
      ],
      "optional_fields": ["check.boundary_violations[]"],
      "empty_ok": true,
      "instance_fields": ["file", "start_line", "end_line"],
      "file_score_fields": [
        "path",
        "total_cyclomatic",
        "total_cognitive",
        "crap_above_threshold"
      ]
    },
    {
      "id": "list-boundaries",
      "argv": ["list", "--boundaries", "--format", "json", "--quiet"],
      "kind": "list-boundaries",
      "require_schema": false,
      "required_fields": [
        "kind",
        "boundaries.configured",
        "boundaries.zones[]",
        "boundaries.rules[]"
      ],
      "zone_fields": ["name", "patterns", "file_count"]
    },
    {
      "id": "dupes-semantic",
      "argv": ["dupes", "--mode", "semantic", "--format", "json", "--quiet"],
      "kind": "dupes",
      "require_schema": true,
      "required_fields": ["kind", "schema_version", "clone_groups[]"],
      "instance_fields": ["file", "start_line", "end_line"],
      "empty_ok": true
    },
    {
      "id": "dead-code-trace",
      "argv": [
        "dead-code",
        "--trace",
        "<file:export>",
        "--format",
        "json",
        "--quiet"
      ],
      "kind": "trace",
      "require_schema": false,
      "required_fields": ["kind", "file", "export_name", "is_used", "reason"]
    },
    {
      "id": "dead-code-trace-file",
      "argv": [
        "dead-code",
        "--trace-file",
        "<file>",
        "--format",
        "json",
        "--quiet"
      ],
      "kind": "trace",
      "require_schema": false,
      "required_fields": ["kind", "file"]
    },
    {
      "id": "dead-code-trace-dependency",
      "argv": [
        "dead-code",
        "--trace-dependency",
        "<name>",
        "--format",
        "json",
        "--quiet"
      ],
      "kind": "trace",
      "require_schema": false,
      "required_fields": ["kind", "package_name", "is_used"]
    }
  ]
}
