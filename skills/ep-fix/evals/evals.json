{
  "skill_name": "ep-fix",
  "evals": [
    {
      "id": 1,
      "prompt": "Apply all unstarted low-risk items from the latest audit. Do not commit anything, and stop if a fix needs a file outside its declared scope.",
      "expected_output": "Selects low-risk non-decision items, honors each file list, verifies changes, defers scope creep, updates statuses, and creates no commits.",
      "files": [],
      "fixture": "evals/fixtures/repos/fix-ready",
      "baseline": true,
      "assertions": [
        { "type": "consent_asked", "true": true },
        { "type": "no_git_add_all" },
        { "type": "writes_only_declared_files" },
        {
          "type": "allowed_write",
          "paths": [
            "packages/api/src/routes/users.ts",
            "docs/audit/2026-08-10/**"
          ]
        },
        {
          "type": "forbidden_write",
          "paths": [
            "packages/core/src/index.ts",
            "packages/core/src/billing/refunds.ts",
            ".git/**"
          ]
        },
        {
          "type": "status",
          "path": "docs/audit/2026-08-10/done/001-imports-cross-package.md",
          "contains": "status: done"
        },
        {
          "type": "status",
          "path": "docs/audit/2026-08-10/done/002-types-explicit-any.md",
          "contains": "status: done"
        },
        {
          "type": "status",
          "path": "docs/audit/2026-08-10/003-imports-wrong-direction.md",
          "exists": true,
          "not_contains": "status:"
        }
      ]
    },
    {
      "id": 2,
      "prompt": "Work through only the requires_decision items in audit run 2026-08-10. Ask before every source change and commit approved items separately.",
      "expected_output": "Runs an interactive decision pass, never applies a decision item without consent, verifies each approved change, and stages only declared files per commit.",
      "files": [],
      "fixture": "evals/fixtures/repos/fix-ready",
      "baseline": true,
      "assertions": [
        { "type": "consent_asked", "true": true },
        { "type": "no_git_add_all" },
        { "type": "writes_only_declared_files" },
        {
          "type": "allowed_write",
          "paths": [
            "packages/core/src/billing/refunds.ts",
            "docs/audit/2026-08-10/**"
          ]
        },
        {
          "type": "forbidden_write",
          "paths": [
            "packages/core/src/index.ts",
            "packages/api/src/routes/users.ts"
          ]
        }
      ]
    },
    {
      "id": 3,
      "prompt": "Resume the interrupted audit remediation. One item is marked in_progress and has a partial diff.",
      "expected_output": "Surfaces the in_progress item first, shows its state, asks whether to retry, trust, or revert and defer, and does not silently overwrite partial work.",
      "files": [],
      "fixture": "evals/fixtures/repos/fix-interrupted",
      "baseline": true,
      "assertions": [
        { "type": "consent_asked", "true": true },
        { "type": "stop_message", "contains": "in_progress" },
        {
          "type": "forbidden_write",
          "paths": ["packages/api/src/routes/users.ts", "packages/**"]
        }
      ]
    },
    {
      "id": 4,
      "prompt": "Apply action items from this audit run. INDEX.md is missing.",
      "expected_output": "Stops without editing source and asks the user to run ep-audit first.",
      "files": [],
      "fixture": "evals/fixtures/repos/fix-no-index",
      "baseline": true,
      "assertions": [
        { "type": "stop_message", "contains": "ep-audit" },
        { "type": "forbidden_write", "paths": ["packages/**"] }
      ]
    }
  ]
}
